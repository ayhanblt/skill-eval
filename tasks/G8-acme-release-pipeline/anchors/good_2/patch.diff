+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+
+def _prep_repo(src: Path, dst: Path) -> None:
+    shutil.copytree(src, dst, ignore=shutil.ignore_patterns("__pycache__", "releases", ".git"))
+    for p in list((dst / "tests").glob("test_release_*.py")):
+        p.unlink()
+    env = {
+        **os.environ,
+        "GIT_CONFIG_GLOBAL": "/dev/null",
+        "GIT_CONFIG_NOSYSTEM": "1",
+        "GIT_AUTHOR_NAME": "t",
+        "GIT_AUTHOR_EMAIL": "t@local",
+        "GIT_COMMITTER_NAME": "t",
+        "GIT_COMMITTER_EMAIL": "t@local",
+    }
+    subprocess.run(["git", "init", "-q"], cwd=str(dst), env=env, check=True)
+    subprocess.run(["git", "add", "-A"], cwd=str(dst), env=env, check=True)
+    subprocess.run(["git", "commit", "-q", "-m", "init"], cwd=str(dst), env=env, check=True)
+
+
+def test_migration_rollback_and_manifest_seal(tmp_path: Path) -> None:
+    root = Path(__file__).resolve().parent.parent
+    repo = tmp_path / "repo_ok"
+    _prep_repo(root, repo)
+    out = tmp_path / "rel"
+    proc = subprocess.run(
+        [sys.executable, str(repo / "scripts" / "build_release.py"), "--out", str(out)],
+        cwd=str(repo),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert proc.returncode == 0, proc.stderr
+    m = json.loads((out / "release-manifest.json").read_text(encoding="utf-8"))
+    assert m["bundle_format"] == "acme-rel-1" and m["rollback_verified"] is True and len(m["migrations"]) == 3
+    assert "  release-manifest.json\n" in (out / "MANIFEST.sha256").read_text(encoding="utf-8")
+
+
+def test_failing_test_and_broken_down_abort_without_manifest(tmp_path: Path) -> None:
+    root = Path(__file__).resolve().parent.parent
+    repo = tmp_path / "repo_fail"
+    _prep_repo(root, repo)
+    (repo / "tests" / "test_break.py").write_text("def test_fail():\n    assert False\n", encoding="utf-8")
+    out = tmp_path / "fail_rel"
+    proc = subprocess.run(
+        [sys.executable, str(repo / "scripts" / "build_release.py"), "--out", str(out)],
+        cwd=str(repo),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert proc.returncode != 0
+    assert not (out / "release-manifest.json").exists()
+
+    repo2 = tmp_path / "repo_bad_mig"
+    _prep_repo(root, repo2)
+    (repo2 / "migrations" / "003_add_settlement_batches.down.sql").write_text("DROP TABLE missing_tbl;\n", encoding="utf-8")
+    out2 = tmp_path / "fail_mig"
+    proc2 = subprocess.run([sys.executable, str(repo2 / "scripts" / "build_release.py"), "--out", str(out2)], cwd=str(repo2), check=False)
+    assert proc2.returncode != 0
+    assert not (out2 / "release-manifest.json").exists()
