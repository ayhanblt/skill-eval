+        db.execute("INSERT INTO settlement_batches (batch_id, status, created_at) VALUES ('b-1','open','2026-01-01T00:00:00Z')")
+        assert db.execute("SELECT status FROM settlement_batches WHERE batch_id='b-1'").fetchall() == [("open",)]
+        for down in reversed(downs):
+            db.executescript(down.read_text(encoding="utf-8"))
+        assert db.execute("SELECT name FROM sqlite_master WHERE type IN ('table','index') AND name NOT LIKE 'sqlite_%'").fetchall() == []
+        for up in ups:
+            db.executescript(up.read_text(encoding="utf-8"))
+        db.close()
+    return out
+
+
