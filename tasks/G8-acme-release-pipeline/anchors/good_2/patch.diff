+def run_preflight_migrations(root: Path) -> list[dict[str, str]]:
+    mig_dir = root / "migrations"
+    ups = sorted(mig_dir.glob("*.up.sql"))
+    downs = sorted(mig_dir.glob("*.down.sql"))
+    if [p.name[:-7] for p in ups] != [p.name[:-9] for p in downs]:
+        raise RuntimeError("Missing matching .down.sql migration")
+    out = []
+    for up, down in zip(ups, downs):
+        out.append({
+            "name": up.name[:-7],
+            "up": f"migrations/{up.name}",
+            "down": f"migrations/{down.name}",
+            "up_sha256": digest(up),
+            "down_sha256": digest(down),
+        })
+    with tempfile.TemporaryDirectory() as tmp:
+        db = sqlite3.connect(Path(tmp) / "mig.db")
+        for up in ups:
