+    art_dir = out / "artifacts"
+    art_dir.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(root / "VERSION", art_dir / "VERSION")
+    shutil.copytree(root / "service", art_dir / "service", ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "*.tmp", "*.bak"))
+    shutil.copytree(root / "migrations", art_dir / "migrations")
+    artifacts = sorted(
+        ({"path": p.relative_to(out).as_posix(), "sha256": digest(p), "bytes": p.stat().st_size} for p in art_dir.rglob("*") if p.is_file()),
+        key=lambda x: x["path"],
