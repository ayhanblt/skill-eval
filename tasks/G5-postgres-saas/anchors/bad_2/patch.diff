diff --git a/sql/migrations/002_optimizations.sql b/sql/migrations/002_optimizations.sql
--- a/sql/migrations/002_optimizations.sql
+++ b/sql/migrations/002_optimizations.sql
@@ -1,2 +1,5 @@
+CREATE INDEX IF NOT EXISTS events_active_keyset_idx ON events (tenant_id, created_at DESC, id DESC) INCLUDE (project_id, kind) WHERE deleted_at IS NULL AND status = 'active';
+CREATE INDEX IF NOT EXISTS events_active_project_idx ON events (project_id, created_at DESC) WHERE deleted_at IS NULL AND status = 'active';
+CREATE INDEX IF NOT EXISTS jobs_pending_idx ON jobs (priority DESC, created_at ASC, id ASC) WHERE status = 'pending';
+-- Baseline RLS policies kept unchanged without (SELECT current_setting(...)) initPlan wrapper
diff --git a/app/queries.py b/app/queries.py
--- a/app/queries.py
+++ b/app/queries.py
@@ -1,6 +1,57 @@
-"""Data-access layer for Northstar SaaS (baseline with intentional bottlenecks)."""
+"""Partially optimized query layer."""
+from __future__ import annotations
+import json
+from datetime import datetime
+from typing import Any
+
+def list_active_events_page(conn: Any, tenant_id: int, *, cursor_created_at: datetime | None = None, cursor_id: int | None = None, limit: int = 25) -> list[dict[str, Any]]:
+    with conn.cursor() as cur:
+        if cursor_created_at is not None and cursor_id is not None:
+            cur.execute(
+                """
+                SELECT id, project_id, kind, created_at
+                FROM events
+                WHERE tenant_id = %s AND deleted_at IS NULL AND status = 'active'
+                  AND (created_at, id) < (%s, %s)
+                ORDER BY created_at DESC, id DESC
+                LIMIT %s
+                """,
+                (tenant_id, cursor_created_at, cursor_id, limit),
+            )
+        else:
+            cur.execute(
+                "SELECT id, project_id, kind, created_at FROM events WHERE tenant_id = %s AND deleted_at IS NULL AND status = 'active' ORDER BY created_at DESC, id DESC LIMIT %s",
+                (tenant_id, limit),
+            )
+        rows = cur.fetchall()
+    return [{"id": r[0], "project_id": r[1], "kind": r[2], "created_at": r[3]} for r in rows]
+
+def get_tenant_project_summaries(conn: Any, tenant_id: int) -> list[dict[str, Any]]:
+    # Uses INNER JOIN instead of LEFT JOIN, silently dropping projects with 0 active events!
+    with conn.cursor() as cur:
+        cur.execute(
+            "SELECT p.id, p.name, COUNT(e.id), MAX(e.created_at) FROM projects p INNER JOIN events e ON e.project_id = p.id WHERE p.tenant_id = %s AND e.deleted_at IS NULL AND e.status = 'active' GROUP BY p.id, p.name ORDER BY p.id ASC",
+            (tenant_id,),
+        )
+        rows = cur.fetchall()
+    return [{"project_id": r[0], "name": r[1], "active_event_count": int(r[2]), "last_event_at": r[3]} for r in rows]
+
+def claim_next_job(conn: Any, worker_id: str) -> dict[str, Any] | None:
+    # Still omits SKIP LOCKED!
+    with conn.cursor() as cur:
+        cur.execute("SELECT id FROM jobs WHERE status = 'pending' ORDER BY priority DESC LIMIT 1 FOR UPDATE")
+        row = cur.fetchone()
+        return None if not row else {"id": row[0], "status": "processing"}
+
+def bulk_insert_events(conn: Any, rows: list[dict[str, Any]]) -> int:
+    # Bug: still executes per-row INSERT loop instead of batch insert
+    with conn.cursor() as cur:
+        for r in rows:
+            cur.execute("INSERT INTO events VALUES (%s, %s, %s, %s, %s, %s::jsonb, %s, %s)", (r["id"], r["tenant_id"], r["project_id"], r["status"], r["kind"], json.dumps(r["payload"]), r.get("deleted_at"), r["created_at"]))
+    return len(rows)
