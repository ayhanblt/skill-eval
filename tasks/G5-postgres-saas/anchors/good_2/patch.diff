diff --git a/sql/migrations/002_optimizations.sql b/sql/migrations/002_optimizations.sql
--- a/sql/migrations/002_optimizations.sql
+++ b/sql/migrations/002_optimizations.sql
@@ -1,2 +1,14 @@
+CREATE INDEX IF NOT EXISTS idx_events_active_cursor ON events (tenant_id, created_at DESC, id DESC) INCLUDE (project_id, kind) WHERE deleted_at IS NULL AND status = 'active';
+CREATE INDEX IF NOT EXISTS idx_events_project_active ON events (project_id, created_at DESC) WHERE deleted_at IS NULL AND status = 'active';
+CREATE INDEX IF NOT EXISTS idx_jobs_queue ON jobs (priority DESC, created_at ASC, id ASC) WHERE status = 'pending';
+CREATE INDEX IF NOT EXISTS idx_projects_rls ON projects (tenant_id, owner_id) INCLUDE (is_private, name);
+DROP POLICY IF EXISTS events_tenant_policy ON events;
+CREATE POLICY events_tenant_policy ON events FOR ALL TO app_user
+  USING (tenant_id = (SELECT NULLIF(current_setting('app.current_tenant_id', true), '')::bigint))
+  WITH CHECK (tenant_id = (SELECT NULLIF(current_setting('app.current_tenant_id', true), '')::bigint));
+DROP POLICY IF EXISTS projects_tenant_policy ON projects;
+CREATE POLICY projects_tenant_policy ON projects FOR ALL TO app_user
+  USING (tenant_id = (SELECT NULLIF(current_setting('app.current_tenant_id', true), '')::bigint) AND (NOT is_private OR owner_id = (SELECT NULLIF(current_setting('app.current_user_id', true), '')::bigint)))
+  WITH CHECK (tenant_id = (SELECT NULLIF(current_setting('app.current_tenant_id', true), '')::bigint));
diff --git a/app/queries.py b/app/queries.py
--- a/app/queries.py
+++ b/app/queries.py
@@ -1,6 +1,103 @@
-"""Data-access layer for Northstar SaaS (baseline with intentional bottlenecks)."""
+"""Optimized SQL query layer."""
+from __future__ import annotations
+import json
+from datetime import datetime
+from typing import Any
+
+def list_active_events_page(conn: Any, tenant_id: int, *, cursor_created_at: datetime | None = None, cursor_id: int | None = None, limit: int = 25) -> list[dict[str, Any]]:
+    with conn.cursor() as cur:
+        if cursor_created_at is not None and cursor_id is not None:
+            cur.execute(
+                """
+                SELECT id, project_id, kind, created_at
+                FROM events
+                WHERE tenant_id = %s AND deleted_at IS NULL AND status = 'active'
+                  AND (created_at, id) < (%s, %s)
+                ORDER BY created_at DESC, id DESC
+                LIMIT %s
+                """,
+                (tenant_id, cursor_created_at, cursor_id, limit),
+            )
+        else:
+            cur.execute(
+                """
+                SELECT id, project_id, kind, created_at
+                FROM events
+                WHERE tenant_id = %s AND deleted_at IS NULL AND status = 'active'
+                ORDER BY created_at DESC, id DESC
+                LIMIT %s
+                """,
+                (tenant_id, limit),
+            )
+        rows = cur.fetchall()
+    return [{"id": r[0], "project_id": r[1], "kind": r[2], "created_at": r[3]} for r in rows]
+
+def get_tenant_project_summaries(conn: Any, tenant_id: int) -> list[dict[str, Any]]:
+    with conn.cursor() as cur:
+        cur.execute(
+            """
+            SELECT p.id, p.name,
+                   COUNT(e.id) FILTER (WHERE e.deleted_at IS NULL AND e.status = 'active') AS active_event_count,
+                   MAX(e.created_at) FILTER (WHERE e.deleted_at IS NULL AND e.status = 'active') AS last_event_at
+            FROM projects p
+            LEFT JOIN events e ON e.project_id = p.id
+            WHERE p.tenant_id = %s
+            GROUP BY p.id, p.name
+            ORDER BY p.id ASC
+            """,
+            (tenant_id,),
+        )
+        rows = cur.fetchall()
+    return [{"project_id": r[0], "name": r[1], "active_event_count": int(r[2] or 0), "last_event_at": r[3]} for r in rows]
+
+def claim_next_job(conn: Any, worker_id: str) -> dict[str, Any] | None:
+    with conn.cursor() as cur:
+        cur.execute(
+            """
+            UPDATE jobs SET status = 'processing', worker_id = %s, locked_at = now()
+            WHERE id = (
+              SELECT id FROM jobs WHERE status = 'pending'
+              ORDER BY priority DESC, created_at ASC, id ASC LIMIT 1 FOR UPDATE SKIP LOCKED
+            )
+            RETURNING id, tenant_id, priority, worker_id, status
+            """,
+            (worker_id,),
+        )
+        c = cur.fetchone()
+    return None if not c else {"id": c[0], "tenant_id": c[1], "priority": c[2], "worker_id": c[3], "status": c[4]}
+
+def list_tenant_event_feed_summary(conn: Any, tenant_id: int, *, limit: int = 50) -> list[dict[str, Any]]:
+    with conn.cursor() as cur:
+        cur.execute(
+            "SELECT id, project_id, kind, created_at FROM events WHERE tenant_id = %s AND deleted_at IS NULL AND status = 'active' ORDER BY created_at DESC, id DESC LIMIT %s",
+            (tenant_id, limit),
+        )
+        rows = cur.fetchall()
+    return [{"id": r[0], "project_id": r[1], "kind": r[2], "created_at": r[3]} for r in rows]
+
+def bulk_insert_events(conn: Any, rows: list[dict[str, Any]]) -> int:
+    if not rows:
+        return 0
+    with conn.cursor() as cur:
+        cur.execute(
+            """
+            INSERT INTO events (id, tenant_id, project_id, status, kind, payload, deleted_at, created_at)
+            SELECT * FROM UNNEST(%s::bigint[], %s::bigint[], %s::bigint[], %s::text[], %s::text[], %s::jsonb[], %s::timestamptz[], %s::timestamptz[])
+            """,
+            (
+                [r["id"] for r in rows], [r["tenant_id"] for r in rows], [r["project_id"] for r in rows],
+                [r["status"] for r in rows], [r["kind"] for r in rows],
+                [r["payload"] if isinstance(r["payload"], str) else json.dumps(r["payload"]) for r in rows],
+                [r.get("deleted_at") for r in rows], [r["created_at"] for r in rows],
+            ),
+        )
+    return len(rows)
