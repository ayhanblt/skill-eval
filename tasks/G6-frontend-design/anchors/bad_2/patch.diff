diff --git a/site/app.js b/site/app.js
--- a/site/app.js
+++ b/site/app.js
@@ -1 +1,14 @@
-// Implement conservatory interactive almanac in site/app.js.
+fetch("./data/specimens.json").then((r) => r.json()).then((d) => {
+  const host = document.getElementById("cards");
+  for (const s of d.specimens) {
+    const card = document.createElement("div");
+    const h3 = document.createElement("h3");
+    h3.textContent = `${s.biome.toUpperCase()} · ${s.commonName}`;
+    const p = document.createElement("p");
+    p.textContent = s.summary;
+    const link = document.createElement("a");
+    link.href = "#";
+    link.textContent = "Inspect →";
+    card.append(h3, p, link);
+    host.appendChild(card);
+  }
+});
