+import { AbsoluteFill, Easing, interpolate, useCurrentFrame, useVideoConfig } from "remotion";
+export const IntroScene = ({ title, subtitle, accentColor }) => {
+  const frame = useCurrentFrame(); const { fps } = useVideoConfig();
+  const y = interpolate(frame, [0, fps], [24, 0], { extrapolateLeft: "clamp", extrapolateRight: "clamp", easing: Easing.bezier(0.16, 1, 0.3, 1) });
+  return <AbsoluteFill style={{ translate: `0px ${y}px` }}><h1 style={{ color: accentColor }}>{title}</h1><p>{subtitle}</p></AbsoluteFill>;
+};
+export const KpiScene = ({ kpis }) => {
+  const frame = useCurrentFrame(); const { fps } = useVideoConfig();
+  const s = interpolate(frame, [0, fps], [0.9, 1], { extrapolateLeft: "clamp", extrapolateRight: "clamp", easing: Easing.spring({ damping: 200 }) });
+  return <AbsoluteFill style={{ scale: String(s) }}>{kpis.map((k) => <div key={k.label}>{k.label}: {k.value}</div>)}</AbsoluteFill>;
+};
+export const BarChartScene = ({ bars, accentColor }) => {
+  const frame = useCurrentFrame(); const { fps } = useVideoConfig();
+  const w = interpolate(frame, [0, 1.5 * fps], [0, 1], { extrapolateLeft: "clamp", extrapolateRight: "clamp", easing: Easing.bezier(0.16, 1, 0.3, 1) });
+  return <AbsoluteFill>{bars.map((b) => <div key={b.label} style={{ width: `${b.value * w}%`, backgroundColor: accentColor }}>{b.label}</div>)}</AbsoluteFill>;
+};
+export const OutroScene = ({ takeaway, cta }) => {
+  const frame = useCurrentFrame(); const { fps } = useVideoConfig();
+  const op = interpolate(frame, [0, fps], [0, 1], { extrapolateLeft: "clamp", extrapolateRight: "clamp", easing: Easing.bezier(0.16, 1, 0.3, 1) });
+  return <AbsoluteFill style={{ opacity: op }}><div>{takeaway}</div><div>{cta}</div></AbsoluteFill>;
+};
