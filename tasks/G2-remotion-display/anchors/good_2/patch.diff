@@ -0,0 +1,20 @@
+import { AbsoluteFill, Sequence, useVideoConfig } from "remotion";
+import { AudioTrack } from "./components/AudioTrack";
+import { SubtitlesOverlay } from "./components/SubtitlesOverlay";
+import { IntroScene, KpiScene, BarChartScene, OutroScene } from "./scenes/Scenes";
+export const StoryVideo = (props) => {
+  const { fps } = useVideoConfig();
+  const [f1, f2, f3, f4] = props.sceneDurationsSec.map((s) => Math.round(s * fps));
+  return (
+    <AbsoluteFill style={{ backgroundColor: props.backgroundColor }}>
+      <AudioTrack />
+      <Sequence from={0} durationInFrames={f1}><IntroScene {...props} /></Sequence>
+      <Sequence from={f1} durationInFrames={f2}><KpiScene {...props} /></Sequence>
+      <Sequence from={f1 + f2} durationInFrames={f3}><BarChartScene {...props} /></Sequence>
+      <Sequence from={f1 + f2 + f3} durationInFrames={f4}><OutroScene {...props} /></Sequence>
+      <SubtitlesOverlay captions={props.captions} />
+    </AbsoluteFill>
+  );
+};
