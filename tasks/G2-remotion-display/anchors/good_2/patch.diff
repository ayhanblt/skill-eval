+  subtitle: z.string(),
+  accentColor: zColor(),
+  backgroundColor: zColor(),
+  sceneDurationsSec: z.array(z.number().positive()).length(4),
+  kpis: z.array(z.object({ label: z.string(), value: z.string(), delta: z.string() })),
