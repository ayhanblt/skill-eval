@@ -0,0 +1,6 @@
+import { useCurrentFrame, useVideoConfig } from "remotion";
+export const SubtitlesOverlay = ({ captions }) => {
+  const frame = useCurrentFrame(); const { fps } = useVideoConfig(); const tMs = (frame / fps) * 1000;
+  const cur = captions.find((c) => tMs >= c.startMs && tMs < c.endMs);
+  return cur ? <div style={{ position: "absolute", bottom: 32 }}>{cur.text}</div> : null;
+};
