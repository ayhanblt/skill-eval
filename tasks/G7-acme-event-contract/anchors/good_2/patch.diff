 """HTTP-style order event handler."""
 
 from __future__ import annotations
 
+import hashlib
+import json
+import uuid
+from datetime import datetime, timezone
 from pathlib import Path
+from typing import Any
 
 from acme_orders.models import HttpResponse
 from acme_orders.storage import OrderStorage
 
 
+def _canonical_sha256(obj: dict[str, Any]) -> str:
+    encoded = json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _now_z() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+
+
+def _lookup_header(headers: dict[str, str], target: str) -> str | None:
+    low = target.lower()
+    for k, v in headers.items():
+        if k.lower() == low and v.strip():
+            return v.strip()
+    return None
+
+
+def _acme_error(status: int, code: str, corr: str, message: str, retryable: bool = False) -> HttpResponse:
+    return HttpResponse(
+        status=status,
+        headers={"Content-Type": "application/json", "X-Correlation-Id": corr},
+        body={
+            "error": {
+                "code": code,
+                "retryable": retryable,
+                "correlation_id": corr,
+                "message": message,
+            }
+        },
+    )
+
+
 class AcmeOrderEventService:
     def __init__(self, data_dir: Path | str) -> None:
         self.storage = OrderStorage(data_dir)
 
+    def _write_audit(self, actor: str, outcome: str, sha: str, corr: str, err_code: str | None = None) -> None:
+        self.storage.append_audit(
+            actor_id=actor,
+            action="order.ingest",
+            outcome=outcome,
+            payload_sha256=sha,
+            correlation_id=corr,
+            error_code=err_code,
+            recorded_at_utc=_now_z(),
+        )
+
     def handle_request(self, headers: dict[str, str], body: bytes) -> HttpResponse:
-        raise NotImplementedError("Implement handle_request according to docs/")
+        corr = _lookup_header(headers, "X-Correlation-Id") or str(uuid.uuid4())
+        actor = _lookup_header(headers, "X-Actor-Id") or "anonymous"
+        sha = hashlib.sha256(body).hexdigest()
+        payload: dict[str, Any] | None = None
+        try:
+            obj = json.loads(body.decode("utf-8"))
+            if isinstance(obj, dict):
+                payload = obj
+                sha = _canonical_sha256(obj)
+        except Exception:
+            payload = None
+
+        idem = _lookup_header(headers, "X-Acme-Idempotency-Key")
+        if not idem:
+            self._write_audit(actor, "rejected", sha, corr, "ACME_EVT_400_MISSING_IDEMPOTENCY_KEY")
+            return _acme_error(400, "ACME_EVT_400_MISSING_IDEMPOTENCY_KEY", corr, "X-Acme-Idempotency-Key required")
+
+        if payload is None:
+            self._write_audit(actor, "rejected", sha, corr, "ACME_EVT_400_INVALID_PAYLOAD")
+            return _acme_error(400, "ACME_EVT_400_INVALID_PAYLOAD", corr, "Body must be a JSON object")
+
+        prev = self.storage.get_idempotency(idem)
+        if prev is not None:
+            if prev["payload_sha256"] != sha:
+                self._write_audit(actor, "rejected", sha, corr, "ACME_EVT_409_PAYLOAD_MISMATCH")
+                return _acme_error(409, "ACME_EVT_409_PAYLOAD_MISMATCH", corr, "Payload hash conflict")
+            self._write_audit(actor, "replayed", sha, corr, None)
+            return HttpResponse(
+                status=prev["response_status"],
+                headers={"Content-Type": "application/json", "X-Acme-Replayed": "true", "X-Correlation-Id": corr},
+                body=prev["response_body"],
+            )
+
+        tid, oid, amt = payload.get("tenant_id"), payload.get("order_id"), payload.get("amount_cents")
+        if not isinstance(tid, str) or not tid.strip() or not isinstance(oid, str) or not oid.strip() or isinstance(amt, bool) or not isinstance(amt, int) or amt <= 0:
+            self._write_audit(actor, "rejected", sha, corr, "ACME_EVT_400_INVALID_PAYLOAD")
+            return _acme_error(400, "ACME_EVT_400_INVALID_PAYLOAD", corr, "Invalid required order fields")
+
+        envelope = {
+            "schema_version": "acme.v2",
+            "event_id": str(uuid.uuid4()),
+            "correlation_id": corr,
+            "tenant_id": tid,
+            "order_id": oid,
+            "amount_cents": amt,
+            "event_type": str(payload.get("event_type") or "order.submitted"),
+            "occurred_at_utc": _now_z(),
+        }
+        self.storage.save_accepted_event(envelope, idem, sha, 201, envelope)
+        self._write_audit(actor, "accepted", sha, corr, None)
+        return HttpResponse(status=201, headers={"Content-Type": "application/json", "X-Correlation-Id": corr}, body=envelope)
diff --git a/tests/test_contracts.py b/tests/test_contracts.py
new file mode 100644
--- /dev/null
+++ b/tests/test_contracts.py
@@ -0,0 +1,22 @@
+from pathlib import Path
+from acme_orders.handler import AcmeOrderEventService
+
+def test_missing_x_acme_header(tmp_path: Path) -> None:
+    svc = AcmeOrderEventService(tmp_path)
+    r = svc.handle_request({"Idempotency-Key": "gen"}, b'{"tenant_id":"t","order_id":"o","amount_cents":10}')
+    assert r.status == 400 and r.body["error"]["code"] == "ACME_EVT_400_MISSING_IDEMPOTENCY_KEY"
+
+def test_canonical_json_replay_and_409_conflict(tmp_path: Path) -> None:
+    svc = AcmeOrderEventService(tmp_path)
+    r1 = svc.handle_request({"X-Acme-Idempotency-Key": "k1"}, b'{"tenant_id":"t","order_id":"o","amount_cents":10,"email":"a@b.c"}')
+    r2 = svc.handle_request({"X-Acme-Idempotency-Key": "k1"}, b'{"amount_cents":10,"email":"a@b.c","order_id":"o","tenant_id":"t"}')
+    assert r1.body["occurred_at_utc"].endswith("Z")
+    assert r2.headers["X-Acme-Replayed"] == "true" and r2.body["event_id"] == r1.body["event_id"]
+    r3 = svc.handle_request({"X-Acme-Idempotency-Key": "k1"}, b'{"tenant_id":"t","order_id":"o","amount_cents":99}')
+    assert r3.status == 409 and r3.body["error"]["code"] == "ACME_EVT_409_PAYLOAD_MISMATCH"
+
+def test_audit_excludes_pii_and_records_rejections(tmp_path: Path) -> None:
+    svc = AcmeOrderEventService(tmp_path)
+    svc.handle_request({"Authorization": "Bearer secret-tok"}, b'{"customer_email":"pii@x.com"}')
+    txt = (tmp_path / "audit.jsonl").read_text(encoding="utf-8")
+    assert "pii@x.com" not in txt and "secret-tok" not in txt and "rejected" in txt
