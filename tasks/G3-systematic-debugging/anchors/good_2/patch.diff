--- a/billing_svc/batch_runner.py
+++ b/billing_svc/batch_runner.py
@@ -28,6 +28,7 @@ class BatchRunner:
         self.ledger = ledger or CreditLedger()
+        self._reconciled_by_invoice: dict[str, BatchItemResult] = {}
 
     def process_batch(self, items: list[BatchItem]) -> list[BatchItemResult]:
         results = []
         for idx, item in enumerate(items, start=1):
+            if item.invoice_id.strip() in self._reconciled_by_invoice:
+                results.append(self._reconciled_by_invoice[item.invoice_id.strip()])
+                continue
             debited = 0
             try:
+                tid = item.tenant_id.strip()
+                if not tid: raise PricingError("blank tenant_id")
+                non_ledger = sum(self.cache.get_policy(tid)["feature_credits"]) + item.grant_credit_cents
                 if item.ledger_credit_cents > 0:
                     debited = self.ledger.apply_credit(tid, item.ledger_credit_cents)
                 inv = generate_invoice(item.invoice_id, tid, item.seats, promo_code=item.promo_code, grant_credit_cents=item.grant_credit_cents, ledger_credit_cents=debited, country=item.country, quarter=item.quarter, tax_exempt=item.tax_exempt, cache=self.cache, tax_engine=self.tax_engine)
                 if item.payment_cents is not None:
                     reconcile_payment(inv, WebhookPayment(f"batch-pay-{idx}", item.invoice_id, tid, item.payment_cents))
+                used_ledger = max(0, min(debited, inv.credit_cents - non_ledger))
+                if debited > used_ledger:
+                    self.ledger.refund(tid, debited - used_ledger)
+                res = BatchItemResult(item.invoice_id, tid, "reconciled" if item.payment_cents is not None else "invoiced", inv)
+                if res.status == "reconciled":
+                    self._reconciled_by_invoice[item.invoice_id.strip()] = res
+                results.append(res)
             except (PricingError, ValueError, InvoiceTotalMismatchError) as exc:
+                if debited > 0:
+                    self.ledger.refund(tid, debited)
                 results.append(BatchItemResult(item.invoice_id, item.tenant_id, "failed", error=str(exc)))
diff --git a/DIAGNOSIS.md b/DIAGNOSIS.md
new file mode 100644
--- /dev/null
+++ b/DIAGNOSIS.md
@@ -0,0 +1,6 @@
+# Incident #4812 Root Cause Analysis
+1. Shallow policy copies in cache.py & in-place discounts/feature_credits mutation in pricing.py leaked tenant promos/credits.
+2. tax_engine.py keyed cache by country only and returned mutable dicts corrupted by tax_exempt=True in pricing.py.
+3. batch_runner.py lacked error rollback and excess ledger refund, and lacked duplicate reconciled invoice_id idempotency.
+4. webhook.py, cache.py, ledger.py, and pricing.py lacked defense-in-depth validation/normalization for blank tenant_id and case/whitespace.
+5. currency.py half-up rounding and reconciler.py exact cent equality are intentional invariants, NOT bugs (reconciler.py left unmodified).
diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,33 @@
+import pytest
+from billing_svc.batch_runner import BatchRunner
+from billing_svc.cache import TenantPolicyCache
+from billing_svc.ledger import CreditLedger
+from billing_svc.models import BatchItem, PricingError
+from billing_svc.pricing import generate_invoice
+from billing_svc.tax_engine import TaxEngine
+from billing_svc.webhook import parse_batch_payload
+
+def test_policy_and_credit_isolation():
+    c = TenantPolicyCache()
+    assert generate_invoice("i1", "t1", 2, promo_code="ANNUAL20", grant_credit_cents=500, cache=c).credit_cents == 500
+    inv2 = generate_invoice("i2", "t2", 2, cache=c)
+    assert inv2.discount_cents == 0 and inv2.credit_cents == 0
+
+def test_tax_quarter_and_exempt_isolation():
+    eng = TaxEngine()
+    assert generate_invoice("e1", "te", 1, country="US", quarter="2026Q1", tax_exempt=True, tax_engine=eng).tax_cents == 0
+    assert generate_invoice("q1", "t1", 1, country="US", quarter="2026Q1", tax_engine=eng).tax_cents == 800
+    assert generate_invoice("q2", "t2", 1, country="US", quarter="2026Q2", tax_engine=eng).tax_cents == 825
+
+def test_ledger_rollback_excess_refund_and_idempotency():
+    ledger = CreditLedger({"t": 10_000})
+    r = BatchRunner(ledger=ledger)
+    r.process_batch([BatchItem("bad", "t", seats=0, ledger_credit_cents=5_000)])
+    assert ledger.balance("t") == 10_000
+    item = BatchItem("ok1", "t", seats=1, promo_code="ANNUAL20", grant_credit_cents=6_000, ledger_credit_cents=5_000, payment_cents=0)
+    r.process_batch([item, item])
+    assert ledger.balance("t") == 8_000
+
+def test_defense_in_depth_empty_tenant_rejected():
+    with pytest.raises(PricingError): parse_batch_payload([{"invoice_id": "x", "tenant_id": " ", "seats": 1}])
+    with pytest.raises(PricingError): TenantPolicyCache().get_policy(" ")
+    with pytest.raises(PricingError): CreditLedger().apply_credit("", 10)
+    with pytest.raises(PricingError): generate_invoice("i", "  ", 1)
+    assert parse_batch_payload([{"invoice_id": " w ", "tenant_id": " t ", "seats": 1, "country": " us ", "quarter": "2026q2"}])[0].country == "US"
