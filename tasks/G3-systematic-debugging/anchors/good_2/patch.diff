@@ -14,18 +14,22 @@ class CreditLedger:
     def deposit(self, tenant_id: str, cents: int) -> None:
+        if not isinstance(tenant_id, str) or not tenant_id.strip(): raise PricingError("blank tenant")
+        self._balances[tenant_id.strip()] = self._balances.get(tenant_id.strip(), 0) + cents
     def balance(self, tenant_id: str) -> int:
+        if not isinstance(tenant_id, str) or not tenant_id.strip(): raise PricingError("blank tenant")
+        return self._balances.get(tenant_id.strip(), 0)
     def apply_credit(self, tenant_id: str, requested_cents: int) -> int:
+        if not isinstance(tenant_id, str) or not tenant_id.strip(): raise PricingError("blank tenant")
+        tid = tenant_id.strip()
         avail = self._balances.get(tid, 0)
         used = min(avail, requested_cents)
         self._balances[tid] = avail - used
         return used
     def refund(self, tenant_id: str, cents: int) -> None:
+        if not isinstance(tenant_id, str) or not tenant_id.strip(): raise PricingError("blank tenant")
+        if cents > 0: self._balances[tenant_id.strip()] = self._balances.get(tenant_id.strip(), 0) + cents
