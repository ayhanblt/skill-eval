diff --git a/pricing_engine/calculator.py b/pricing_engine/calculator.py
--- a/pricing_engine/calculator.py
+++ b/pricing_engine/calculator.py
@@ -1,5 +1,112 @@
+from __future__ import annotations
+from datetime import date
+from decimal import Decimal, ROUND_HALF_UP
+from pricing_engine.models import (
+    Contract,
+    InvoiceLineItem,
+    InvoiceQuote,
+    PrepaidCredit,
+    PricingValidationError,
+    SkuCatalogEntry,
+    UsageRecord,
+)
+
+CENT = Decimal("0.01")
+ZERO = Decimal("0.00")
+HUNDRED = Decimal("100")
+
+
+def _q2(v: Decimal) -> Decimal:
+    return v.quantize(CENT, rounding=ROUND_HALF_UP)
+
+
+def _validate_inputs(contract: Contract, usage: list[UsageRecord]) -> dict[str, int]:
+    if contract.billing_period_days <= 0 or contract.proration_days <= 0 or contract.proration_days > contract.billing_period_days:
+        raise PricingValidationError("invalid proration")
+    if contract.monthly_minimum < ZERO or contract.tax_rate_pct < ZERO or contract.credit_cap_pct < ZERO or contract.credit_cap_pct > HUNDRED:
+        raise PricingValidationError("invalid numeric contract bounds")
+    if sum(s.active_days for s in contract.seat_segments) > contract.billing_period_days:
+        raise PricingValidationError("seat_segments active_days exceeds billing_period_days")
+    for s in contract.seat_segments:
+        if s.seats < 0 or s.monthly_seat_price < ZERO or s.active_days <= 0:
+            raise PricingValidationError("invalid seat segment")
+    for a in contract.adjustments:
+        if not a.code.strip():
+            raise PricingValidationError("blank adjustment code")
+    for e in contract.catalog.values():
+        if not e.tiers or e.included_units < 0 or e.tier_mode not in ("GRADUATED", "VOLUME"):
+            raise PricingValidationError("invalid catalog entry")
+        prev = 0
+        for idx, t in enumerate(e.tiers):
+            if t.unit_price < ZERO or (t.up_to is None and idx != len(e.tiers) - 1) or (t.up_to is not None and t.up_to <= prev):
+                raise PricingValidationError("invalid tiers")
+            if t.up_to is not None:
+                prev = t.up_to
+    for r in contract.discounts:
+        if r.value < ZERO or r.min_subtotal < ZERO or (r.max_discount_amount is not None and r.max_discount_amount < ZERO):
+            raise PricingValidationError("invalid discount")
+        if r.kind == "PCT" and r.value > HUNDRED:
+            raise PricingValidationError("pct > 100")
+        if r.starts_on is not None and r.ends_on is not None and r.starts_on > r.ends_on:
+            raise PricingValidationError("invalid discount dates")
+    for c in contract.credits:
+        if c.amount < ZERO:
+            raise PricingValidationError("negative credit")
+    agg: dict[str, int] = {}
+    for r in usage:
+        if r.quantity < 0 or r.sku not in contract.catalog:
+            raise PricingValidationError("invalid usage")
+        agg[r.sku] = agg.get(r.sku, 0) + r.quantity
+    return agg
+
+
+def _price_sku(entry: SkuCatalogEntry, qty: int) -> Decimal:
+    billable = max(0, qty - entry.included_units)
+    if billable == 0:
+        return ZERO
+    if entry.tier_mode == "VOLUME":
+        for t in entry.tiers:
+            if t.up_to is None or billable <= t.up_to:
+                return _q2(Decimal(billable) * t.unit_price)
+        raise PricingValidationError("exceeds tiers")
+    rem = billable
+    prev = 0
+    raw = ZERO
+    for t in entry.tiers:
+        if rem <= 0:
+            break
+        take = rem if t.up_to is None else min(rem, t.up_to - prev)
+        raw += Decimal(take) * t.unit_price
+        rem -= take
+        if t.up_to is not None:
+            prev = t.up_to
+    if rem > 0:
+        raise PricingValidationError("exceeds tiers")
+    return _q2(raw)
+
+
+def _apply_discounts(gross: Decimal, contract: Contract) -> tuple[str | None, Decimal]:
+    # Flaw: ignores date bounds, min_subtotal, max_discount_amount, and picks first non-stackable rule.
+    if not contract.discounts:
+        return None, gross
+    first = contract.discounts[0]
+    sav = _q2(gross * first.value / HUNDRED) if first.kind == "PCT" else _q2(first.value)
+    return first.code, max(ZERO, _q2(gross - sav))
+
+
+def _apply_credits(post_disc: Decimal, credits: tuple[PrepaidCredit, ...]) -> tuple[Decimal, Decimal]:
+    # Flaw: consumes expired credits, ignores credit_cap_pct, and allows negative balance.
+    applied = _q2(sum((c.amount for c in credits), ZERO))
+    return applied, _q2(post_disc - applied)
+
+
+def _compute_tax(taxable_base: Decimal, contract: Contract) -> Decimal:
+    if contract.tax_exempt or contract.tax_rate_pct == ZERO or taxable_base <= ZERO:
+        return ZERO
+    return _q2(taxable_base * contract.tax_rate_pct / HUNDRED)
+
+
+def calculate_invoice(contract: Contract, usage: list[UsageRecord], *, as_of: date) -> InvoiceQuote:
+    _ = as_of
+    agg = _validate_inputs(contract, usage)
+    items = [
+        InvoiceLineItem(s, agg[s], _price_sku(contract.catalog[s], agg[s]), contract.catalog[s].taxable)
+        for s in sorted(agg)
+    ]
+    sub = _q2(sum((i.amount for i in items), ZERO))
+    ns_code, post_disc = _apply_discounts(sub, contract)
+    applied, post_cred = _apply_credits(post_disc, contract.credits)
+    safe_post = max(ZERO, post_cred)
+    tax = _compute_tax(safe_post, contract)
+    return InvoiceQuote(
+        contract_id=contract.contract_id,
+        line_items=tuple(items),
+        usage_subtotal=sub,
+        minimum_true_up=ZERO,
+        gross_subtotal=sub,
+        non_stackable_discount_code=ns_code,
+        discount_total=_q2(sub - post_disc),
+        post_discount_subtotal=post_disc,
+        credits_applied=applied,
+        remaining_credits=(),
+        net_taxable_subtotal=safe_post,
+        tax_amount=tax,
+        total_due=_q2(safe_post + tax),
+    )
diff --git a/tests/test_smoke.py b/tests/test_smoke.py
