+    assert q.tax_amount == Decimal("0.07")
+
+
+def test_negative_taxable_adjustment_reduces_tax_base() -> None:
+    c = Contract(
+        "c5-negadj",
+        _catalog(),
+        adjustments=(Adjustment("CREDIT_NOTE", Decimal("-50.00"), taxable=True),),
+        tax_rate_pct=Decimal("10.00"),
