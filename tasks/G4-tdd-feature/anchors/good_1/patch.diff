+    c = Contract(
+        "c4",
+        _catalog(),
+        credits=(
+            PrepaidCredit("old", Decimal("500.00"), date(2026, 5, 31)),
+            PrepaidCredit("today", Decimal("40.00"), date(2026, 6, 1)),
+            PrepaidCredit("later", Decimal("100.00"), date(2026, 9, 1)),
+        ),
