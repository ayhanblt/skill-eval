diff --git a/pricing_engine/calculator.py b/pricing_engine/calculator.py
--- a/pricing_engine/calculator.py
+++ b/pricing_engine/calculator.py
@@ -1,5 +1,14 @@
+def calculate_invoice(contract, usage, *, as_of):
+    # Uses float arithmetic everywhere, flat tier lookup, ignores included_units, VOLUME mode, max_discount_amount, credit_cap_pct, and validation
+    total = 0.0
+    for r in usage:
+        rate = float(contract.catalog[r.sku].tiers[0].unit_price)
+        total += float(r.quantity) * rate
+    for c in contract.credits:
+        total -= float(c.amount)  # allows negative total and ignores expires_on & credit_cap_pct
+    tax = total * float(contract.tax_rate_pct) / 100.0
+    return total + tax
